<Project Sdk="Microsoft.NET.Sdk">

  <!-- net45: bản .NET Framework CÓ SẴN trong Windows 8 / Server 2012, người dùng không phải
       cài thêm runtime nào. Đừng nâng TargetFramework nếu vẫn cần chạy trên máy đời đó.
       Reference assemblies lấy từ NuGet nên build được cả trên macOS/Linux (dotnet build). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <AssemblyName>TreSSH</AssemblyName>
    <RootNamespace>TreSSH</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Product>Tre SSH</Product>
    <AssemblyTitle>Tre SSH</AssemblyTitle>
    <Company>tre360.vn</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSH/SFTP thuần .NET. 2020.0.2 là bản cuối còn asset net40 (chạy trên .NET 4.5). -->
    <PackageReference Include="SSH.NET" Version="2020.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Nhúng các DLL phụ thuộc vào chính .exe (Program.cs nạp lại lúc chạy) để phát hành
       đúng MỘT file, khỏi phải kèm Renci.SshNet.dll / Newtonsoft.Json.dll bên cạnh. -->
  <Target Name="NhungDll" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)"
                        Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>dep.%(ReferenceCopyLocalPaths.Filename).dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Message Importance="high" Text="Đã nhúng vào .exe: @(EmbeddedResource->'%(LogicalName)', ', ')" />
  </Target>

</Project>
