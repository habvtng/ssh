{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tre SSH",
  "version": "1.0.0",
  "identifier": "vn.tre360.ssh.desktop",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "tre360.vn",
    "copyright": "tre360.vn",
    "category": "DeveloperTool",
    "shortDescription": "SSH/SFTP client",
    "longDescription": "Tre SSH — quản lý server, terminal SSH và duyệt file SFTP trong một app desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"]
      }
    }
  }
}
